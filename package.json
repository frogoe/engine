{
  "name": "frogoe",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/frogoe/engine"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "test": "bun test",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check-types": "bun run --filter \"@frogoe/lint\" check-types && bun run --filter \"@frogoe/contract\" check-types && bun run --filter \"@frogoe/cli\" check-types",
    "knip": "knip",
    "prepare": "lefthook install",
    "registry:check": "bun scripts/validate-registry.mjs",
    "verify": "bun run format:check && bun run lint && bun run check-types && bun test && bun run knip && bun run registry:check"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "^1.4.0",
    "ajv": "^8.20.0",
    "commitlint": "^21.2.2",
    "knip": "^6.33.0",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2"
  }
}
