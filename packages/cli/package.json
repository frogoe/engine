{
  "name": "frogoe",
  "version": "0.3.0",
  "description": "froge CLI — the agent's hands: init, add, run, check, bundle",
  "homepage": "https://github.com/frogoe/engine#readme",
  "bugs": "https://github.com/frogoe/engine/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frogoe/engine.git",
    "directory": "packages/cli"
  },
  "bin": {
    "frogoe": "bin/frogoe.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/cli.js",
      "types": "./dist/cli.d.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "check-types": "tsc --noEmit",
    "build": "tsup && bun scripts/build-copy.mjs",
    "dev": "bun src/cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@puppeteer/browsers": "^3.2.1",
    "citty": "^0.2.2",
    "esbuild": "^0.28.2",
    "hono": "^4.13.5",
    "puppeteer-core": "^25.9.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@frogoe/lint": "workspace:*",
    "tsup": "^8.5.1"
  },
  "engines": {
    "node": ">=22"
  }
}
