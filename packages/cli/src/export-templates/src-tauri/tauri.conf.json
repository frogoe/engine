{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "{{FROGOE_APP_NAME}}",
  "version": "{{FROGOE_APP_VERSION}}",
  "identifier": "{{FROGOE_APP_ID}}",
  "app": {
    "windows": [
      {
        "title": "{{FROGOE_APP_NAME}}",
        "width": 960,
        "height": 640,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; media-src 'self' data:; connect-src 'self'"
    }
  },
  "build": {
    "frontendDist": "../web"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
