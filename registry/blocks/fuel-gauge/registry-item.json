      "path": "fuel-gauge.html",
      "target": "blocks/fuel-gauge.html",
      "type": "frogoe:markup"
    }
  ],
  "bindings": [
    "data-block-fuel",
    "data-block-fuel-label"
  ],
  "placement": "overlay",
  "preview": {
    "demo": "demo.html"
  }
}