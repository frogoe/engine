{
  "$schema": "../../schema/registry-item.schema.json",
  "name": "hud-fuel-gauge",
  "type": "frogoe:block",
  "title": "Fuel Gauge",
  "description": "Resource bar with fuel-can icon and numeric label; drains smoothly, pulses danger under 25% via data-low; themeable via --hud-*",
  "tags": ["hud", "fuel", "bar", "resource", "timer"],
  "files": [
    {
      "path": "hud-fuel-gauge.html",
      "target": "hud/fuel-gauge.html",
      "type": "frogoe:markup"
    }
  ],
  "bindings": ["data-hud-fuel", "data-hud-fuel-label"],
  "placement": "overlay",
  "preview": {
    "demo": "demo.html"
  }
}
