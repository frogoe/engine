  "files": [
    {
      "path": "hud-game-over-card.html",
      "target": "hud/game-over-card.html",
      "type": "frogoe:markup"
    }
  ],
  "bindings": ["data-hud-gameover", "data-hud-final", "data-hud-best", "data-hud-retry"],
  "placement": "overlay-fullscreen",
  "preview": {
    "demo": "demo.html"
  }
}
